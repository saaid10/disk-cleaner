<UserControl x:Class="DiskCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="16">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Auto-clean whitelist" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8">
                Checked categories can be cleaned automatically on schedule (still quarantined for 7 days first). Everything else always needs manual confirm.
            </TextBlock>
            <ItemsControl ItemsSource="{Binding WhitelistOptions}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Auto-clean interval (days)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding AutoCleanIntervalDays}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="Scan roots (used for dev-build folders, log files, duplicates, large/old files)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Add Folder..." Padding="10,4" Command="{Binding AddScanRootCommand}"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding ScanRoots}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2"
                                    Command="{Binding DataContext.RemoveScanRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Removable drives" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,8">
                Excluded from the Dashboard by default to avoid accidentally scanning a plugged-in USB backup drive. Check to include.
            </TextBlock>
            <ItemsControl ItemsSource="{Binding RemovableDriveOptions}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsEnabled}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RemovableDriveOptions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>

            <TextBlock Text="Large/old file thresholds" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Minimum size (MB):" VerticalAlignment="Center" Width="180"/>
                <TextBox Text="{Binding LargeFileMinSizeMb}" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Not accessed in (days):" VerticalAlignment="Center" Width="180"/>
                <TextBox Text="{Binding LargeFileMinDaysSinceAccess}" Width="100"/>
            </StackPanel>

            <TextBlock Text="Log file age threshold" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Older than (days):" VerticalAlignment="Center" Width="180"/>
                <TextBox Text="{Binding LogFileOlderThanDays}" Width="100"/>
            </StackPanel>

            <TextBlock Text="Disk Scan (Treemap) display" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,4">
                Items smaller than this are grouped into a single "Other (small items)" block instead of each getting their own tile.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Hide items smaller than (MB):" VerticalAlignment="Center" Width="180"/>
                <TextBox Text="{Binding TreemapMinSizeMb}" Width="100"/>
            </StackPanel>

            <Button Content="Save Settings" Padding="14,6" HorizontalAlignment="Left" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" Foreground="#555555"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
