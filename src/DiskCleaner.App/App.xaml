<Application x:Class="DiskCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskCleaner.App"
             xmlns:conv="clr-namespace:DiskCleaner.App.Converters">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:FractionToStarConverter x:Key="FractionToStarConverter"/>
        <conv:BoolToQuarantineLabelConverter x:Key="BoolToQuarantineLabelConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:FileTypeCategoryToColorConverter x:Key="FileTypeCategoryToColorConverter"/>
    </Application.Resources>
</Application>
