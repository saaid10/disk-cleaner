<Window x:Class="DiskCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskCleaner.App"
        xmlns:vm="clr-namespace:DiskCleaner.App.ViewModels"
        xmlns:views="clr-namespace:DiskCleaner.App.Views"
        mc:Ignorable="d"
        Title="Disk Cleaner" Height="600" Width="1000">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TreemapViewModel}">
            <views:TreemapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupSuggestionsViewModel}">
            <views:CleanupSuggestionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <views:DuplicatesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeOldFilesViewModel}">
            <views:LargeOldFilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrganizerViewModel}">
            <views:OrganizerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectedFoldersViewModel}">
            <views:ProtectedFoldersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F3F3">
            <StackPanel>
                <TextBlock Text="Disk Cleaner" FontSize="16" FontWeight="Bold" Margin="14,16,14,16"/>
                <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding ShowDashboardCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Disk Scan" Command="{Binding ShowTreemapCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Cleanup Suggestions" Command="{Binding ShowCleanupSuggestionsCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Duplicates" Command="{Binding ShowDuplicatesCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Large &amp; Old Files" Command="{Binding ShowLargeOldFilesCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Quarantine" Command="{Binding ShowQuarantineCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Desktop Organizer" Command="{Binding ShowOrganizerCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Protected Folders" Command="{Binding ShowProtectedFoldersCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="Settings" Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
